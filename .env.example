# Copia este archivo a .env y pon un valor real (nunca subas .env a Git).

# App token opcional de Socrata (sube el límite de peticiones a la API).
SOCRATA_APP_TOKEN=

# Clave secreta para calcular supplier_key (HMAC-SHA-256, contrato §A6.1).
# Sin esta variable, supplier_key() falla con RuntimeError (no hay valor por defecto).
CTRL_CONTRATA_SUPPLIER_KEY=
